{
  "$schema": "https://raw.githubusercontent.com/neutralinojs/neutralinojs/main/schemas/neutralino.config.schema.json",
  "applicationId": "com.zrubix.pattiveedu",
  "version": "10.4.0",
  "defaultMode": "window",
  "port": 47391,
  "documentRoot": "/resources/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": false,
  "tokenSecurity": "none",
  "logging": {
    "enabled": false,
    "writeToLogFile": false
  },
  "nativeAllowList": [],
  "globalVariables": {},
  "modes": {
    "window": {
      "title": "Patti Veedu · பாட்டி வீடு · Grandma's House",
      "width": 1280,
      "height": 760,
      "minWidth": 960,
      "minHeight": 560,
      "center": true,
      "fullScreen": false,
      "alwaysOnTop": false,
      "icon": "/resources/icon.png",
      "enableInspector": false,
      "borderless": false,
      "maximize": true,
      "hidden": false,
      "resizable": true,
      "exitProcessOnClose": true
    }
  },
  "cli": {
    "binaryName": "PattiVeedu",
    "resourcesPath": "/resources/",
    "extensionsPath": "/extensions/",
    "binaryVersion": "6.4.0",
    "clientVersion": "6.4.0"
  }
}